library(ggplot2)
# 1. Parâmetros do Sistema
L <- 100          # Comprimento da rodovia (metros)
T_max <- 50       # Tempo total da simulação
v <- 1.0          # Velocidade constante do fluxo (m/s)
dx <- 1           # Passo no espaço
dt <- 0.5         # Passo no tempo (deve obedecer dt <= dx/v para estabilidade)
nx <- L/dx        # Número de pontos no espaço
nt <- T_max/dt    # Número de pontos no tempo
# 2. Condição Inicial: Um "pulso" de densidade (ex: um comboio de caminhões)
# Começa entre o km 10 e 30
rho <- ifelse(seq(0, L, by=dx) >= 10 & seq(0, L, by=dx) <= 30, 1, 0)
x <- seq(0, L, by=dx)
# 3. Evolução da PDE (Método Upwind)
# Criamos um dataframe para armazenar os resultados e visualizar
resultados <- data.frame(x = x, densidade = rho, tempo = 0)
for(t in 1:nt) {
rho_novo <- rho
for(i in 2:nx) {
# Aproximação da derivada parcial: rho_t + v * rho_x = 0
rho_novo[i] <- rho[i] - v * (dt/dx) * (rho[i] - rho[i-1])
}
rho <- rho_novo
# Salvar apenas alguns frames para o gráfico não ficar pesado
if(t %% 10 == 0) {
resultados <- rbind(resultados, data.frame(x = x, densidade = rho, tempo = t*dt))
}
}
# 4. Visualização
ggplot(resultados, aes(x=x, y=densidade, color=as.factor(tempo))) +
geom_line(size=1) +
labs(title = "Evolução da Densidade de Tráfego (PDE)",
subtitle = "Ondas de densidade se deslocando no espaço ao longo do tempo",
x = "Posição na Rodovia (x)",
y = "Densidade (rho)",
color = "Tempo (t)") +
theme_minimal()
library(ggplot2)
library(tidyr)
# 1. Configurações do Cenário
L <- 100        # Extensão da região (km)
T_max <- 30     # Dias após o desastre
dx <- 1; dt <- 0.1
nx <- L/dx; nt <- T_max/dt
# Coeficiente de difusão (velocidade da propagação da informação/demanda)
D <- 0.5
# 2. Estado Inicial: Zero aplicações em todo lugar
A <- rep(0, nx + 1)
x <- seq(0, L, by=dx)
# 3. Função de "Desastre" (Impacto inicial no centro da cidade no dia 1)
# O desastre gera uma necessidade imediata no ponto x=50
A[50] <- 10
resultados <- data.frame(x = x, aplicacoes = A, dia = 0)
# 4. Evolução da PDE (Equação de Difusão)
for(t in 1:nt) {
A_antigo <- A
for(i in 2:nx) {
# Aproximação da Segunda Derivada (Difusão no espaço)
A[i] <- A_antigo[i] + D * (dt/dx^2) * (A_antigo[i+1] - 2*A_antigo[i] + A_antigo[i-1])
}
# Registrar o progresso a cada 5 dias
if((t * dt) %% 5 == 0) {
resultados <- rbind(resultados, data.frame(x = x, aplicacoes = A, dia = t*dt))
}
}
# 5. Visualização
ggplot(resultados, aes(x=x, y=aplicacoes, color=as.factor(dia))) +
geom_line(size=1.2) +
labs(title = "Predição de Demanda por Assistência Pós-Desastre",
subtitle = "A 'onda' de pedidos se espalhando do epicentro (x=50) ao longo dos dias",
x = "Distância do Centro da Região (km)",
y = "Intensidade de Novas Aplicações",
color = "Dias decorridos") +
theme_minimal()
glm(med_income_k ~ 1, data = data)
library(dplyr)
